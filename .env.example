# Copy to backend/.env (backend) and frontend/.env.local (frontend).
# Never commit real values.

# ---------- Backend (FastAPI on Render) ----------
# Supabase: use the Supavisor SESSION pooler URL (port 5432) when deploying to Render.
# Local tests fall back to SQLite when DATABASE_URL is not set.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres

# Google Gemini (backend only, never expose to the frontend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Limits
MAX_CONTENT_CHARS=10000
ANALYZE_RATE_LIMIT_PER_MINUTE=10

# ---------- Frontend (Vite on Vercel) ----------
VITE_API_BASE_URL=http://localhost:8000
