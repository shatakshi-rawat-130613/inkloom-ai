# Copy to backend/.env (backend) and frontend/.env.local (frontend).
# Never commit real secrets or production passwords.

# ==============================================================================
# Backend Configuration (FastAPI on Render / Local)
# ==============================================================================
# Runtime environment: 'development', 'test', or 'production'
ENVIRONMENT=development

# Database connection:
# - Local SQLite (zero setup default): sqlite:///./inkloom_dev.db
# - PostgreSQL (Supabase / Render): postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres
DATABASE_URL=sqlite:///./inkloom_dev.db

# Google Gemini API (Backend only, never expose to frontend)
# If left empty, deterministic rule engine runs with ai_status="disabled"
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=30.0

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:5173,https://inkloom-ai-wheat.vercel.app

# JWT Authentication:
# - In development: leave blank to auto-generate a safe random per-process secret.
# - In production: REQUIRED. Must be an independently generated strong secret (>= 32 chars).
#   Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Demo Seed Password:
# - Required when running `python -m app.seed` to seed or update demo accounts.
# - Never commit a shared password. Configure your own local password for development.
DEMO_SEED_PASSWORD=

# Content & Rate Limits
MAX_CONTENT_CHARS=10000
ANALYZE_RATE_LIMIT_PER_MINUTE=10

# ==============================================================================
# Frontend Configuration (Vite on Vercel / Local)
# ==============================================================================
# Base URL for FastAPI backend (empty string in production for same-domain or proxy)
VITE_API_BASE_URL=http://localhost:8000

# WARNING: VITE_* variables are embedded in client-side bundle and visible to browsers.
# VITE_DEMO_SEED_PASSWORD must ONLY be set in local frontend/.env.local for development.
# NEVER set VITE_DEMO_SEED_PASSWORD in production (Vercel) builds.
# VITE_DEMO_SEED_PASSWORD=
